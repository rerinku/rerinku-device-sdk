/**
 * @file rerinku_version.h
 * @brief Version of the Rerinku Device SDK headers. Generated by CMake.
 *
 * The library actually linked reports its own version through
 * rerinku_version() / rerinku_version_number().
 */
#ifndef RERINKU_VERSION_H
#define RERINKU_VERSION_H

#define RERINKU_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define RERINKU_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define RERINKU_VERSION_PATCH @PROJECT_VERSION_PATCH@

/** "MAJOR.MINOR.PATCH" */
#define RERINKU_VERSION_STRING "@PROJECT_VERSION@"

/** 0xMMmmpp, for compile-time checks: `#if RERINKU_VERSION_NUMBER >= 0x000500` */
#define RERINKU_VERSION_NUMBER \
    ((RERINKU_VERSION_MAJOR << 16) | (RERINKU_VERSION_MINOR << 8) | RERINKU_VERSION_PATCH)

#endif /* RERINKU_VERSION_H */
